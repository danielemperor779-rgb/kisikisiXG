            {
                q: "19. Tata tertib keselamatan berpakaian di laboratorium kimia yang SALAH adalah...",
                options: ["A. Pakai jas lab lengan panjang terkancing", "B. Menggunakan sepatu sandal terbuka atau hak tinggi", "C. Mengikat rambut panjang", "D. Menggunakan safety goggles", "E. Melepas lensa kontak"],
                ans: 1,
                desc: "Pembahasan: Penggunaan sepatu sandal terbuka atau hak tinggi dilarang keras di lab."
            },
            {
                q: "20. Dokumen keselamatan memuat informasi sifat fisik, bahaya, penyimpanan, dan penanganan darurat zat dinamakan...",
                options: ["A. SOP", "B. ISO 9001", "C. Logbook", "D. Jurnal Praktikum", "E. MSDS / SDS"],
                ans: 4,
                desc: "Pembahasan: Material Safety Data Sheet (MSDS/SDS) memuat seluruh informasi K3 zat kimia."
            }
        ];

        // Buat otomatis 30 soal PG tambahan untuk melengkapi hingga 50
        for(let i=21; i<=50; i++) {
            let mod = i % 5;
            if(mod === 1) {
                pgData.push({
                    q: i + ". Tujuan utama rancangan reaksi kimia dengan ekonomi atom tinggi adalah...",
                    options: ["A. Meminimalkan pembentukan limbah by-product", "B. Mempercepat reaksi tanpa katalis", "C. Menghemat penggunaan air", "D. Meningkatkan tekanan sistem", "E. Mengubah reaksi eksoterm"],
                    ans: 0,
                    desc: "Pembahasan: Ekonomi atom meminimalkan pembentukan limbah/produk sampingan."
                });
            } else if(mod === 2) {
                pgData.push({
                    q: i + ". Bahan kimia berlabel piktogram tengkorak dan tulang bersilang mengindikasikan...",
                    options: ["A. Toksisitas akut beracun fatal", "B. Bahaya iritasi ringan", "C. Korosif logam", "D. Gas bertekanan", "E. Pengoksidasi"],
                    ans: 0,
                    desc: "Pembahasan: Simbol tengkorak menunjukkan zat beracun fatal/toksisitas akut tinggi."
                });
            } else if(mod === 3) {
                pgData.push({
                    q: i + ". Mengapa lensa kontak dilarang digunakan saat praktikum kimia?",
                    options: ["A. Mengganggu penglihatan", "B. Uap zat kimia dapat terperangkap di bawah lensa dan merusak kornea", "C. Lensa dapat meleleh terkena air", "D. Mudah lepas saat praktikum", "E. Menghalangi fungsi goggles"],
                    ans: 1,
                    desc: "Pembahasan: Uap volatil dapat terperangkap di balik lensa dan merusak jaringan mata."
                });
            } else if(mod === 4) {
                pgData.push({
                    q: i + ". Alat laboratorium yang digunakan untuk menimbang padatan kimia secara tepat presisi adalah...",
                    options: ["A. Neraca Analitik", "B. Gelas Ukur", "C. Spatula", "D. Cawan Petri", "E. Pipet Ukur"],
                    ans: 0,
                    desc: "Pembahasan: Neraca analitik digunakan menimbang massa zat padat dengan presisi tinggi."
                });
            } else {
                pgData.push({
                    q: i + ". Mengapa air tidak boleh dituangkan langsung ke dalam Asam Sulfat pekat?",
                    options: ["A. Reaksi menghasilkan panas mendadak yang dapat memercikkan asam (eksoterm tinggi)", "B. Asam akan menguap habis", "C. Reaksi menjadi sangat lambat", "D. Menghasilkan gas beracun", "E. Wadah akan membeku"],
                    ans: 0,
                    desc: "Pembahasan: Reaksi pengenceran H2SO4 pekat sangat eksoterm; air dapat mendidih mendadak dan memercik."
                });
            }
        }

        // DATA SOAL ESAI (15 SOAL)
        const essaiData = [
            {
                q: "1. Jelaskan konsep Ekonomi Atom (Atom Economy) dalam Kimia Hijau dan tuliskan rumus metrik efisiensinya!",
                ans: "Konsep Ekonomi Atom mengukur sejauh mana reaktan terkonversi menjadi produk target. Rumusnya: % Atom Economy = (Massa Molar Produk Target / Total Massa Molar Seluruh Reaktan) x 100%."
            },
            {
                q: "2. Mengapa penggunaan katalis selektif lebih baik dibandingkan menaikkan konsumsi reaktan dalam perspektif Kimia Hijau?",
                ans: "Katalis menurunkan energi aktivasi reaksi tanpa terpakai habis, menghemat konsumsi energi, dan tidak menambah jumlah limbah sampingan."
            },
            {
                q: "3. Jelaskan dua contoh pelarut ramah lingkungan yang aman menggantikan pelarut organik toksik volatil!",
                ans: "1. Air (H2O): Pelarut polar non-toksik.\n2. Karbon Dioksida Superkritis (SCCO2): Memiliki sifat antara gas dan cairan yang mudah dipisahkan kembali."
            },
            {
                q: "4. Tuliskan perbedaan fungsi antara Gelas Ukur dan Labu Ukur (Volumetric Flask) di laboratorium!",
                ans: "Gelas ukur digunakan untuk mengukur/mengambil volume cairan dengan ketelitian sedang, sedangkan Labu Ukur digunakan untuk membuat larutan standar dengan presisi dan ketelitian sangat tinggi."
            },
            {
                q: "5. Mengapa reaksi antara logam Tembaga (Cu) dan Asam Nitrat pekat (HNO3) wajib dilakukan di Lemari Asam?",
                ans: "Karena reaksi tersebut menghasilkan gas Nitrogen Dioksida (NO2) berwarna cokelat yang bersifat beracun dan iritan kuat bagi saluran pernapasan."
            },
            {
                q: "6. Jelaskan langkah pertolongan pertama jika kulit anggota tubuh terkena tumpahan asam pekat!",
                ans: "Segera bilas bagian kulit yang terkena tumpahan dengan air bersih mengalir secara terus-menerus selama minimal 15-20 menit, lalu lepaskan pakaian yang terkontaminasi."
            },
            {
                q: "7. Mengapa pengenceran Asam Sulfat pekat dilakukan dengan cara menambahkan asam ke dalam air, bukan sebaliknya?",
                ans: "Karena reaksi bersifat sangat eksotermik. Jika air dituangkan ke asam pekat, panas tinggi yang terpusat dapat membuat air mendidih mendadak dan memercikkan asam pekat berbahaya."
            },
            {
                q: "8. Jelaskan arti dari piktogram bahaya GHS 'Pohon Kering dan Ikan Mati' serta tata cara penanganan limbahnya!",
                ans: "Menunjukkan bahaya bagi lingkungan akuatik. Limbahnya tidak boleh dibuang langsung ke selokan/lingkungan, melainkan ditampung pada wadah khusus B3."
            },
            {
                q: "9. Sebutkan dan jelaskan 3 informasi penting yang terkandung dalam dokumen MSDS / SDS!",
                ans: "1. Identifikasi sifat fisik dan kimia zat.\n2. Potensi bahaya kesehatan dan keselamatan.\n3. Prosedur pertolongan pertama dan penanganan tumpahan darurat."
            },
            {
                q: "10. Apa fungsi dari alat Corong Pemisah (Separatory Funnel) dan berikan contoh penerapannya!",
                ans: "Berfungsi memisahkan dua zat cair yang tidak saling bercampur (immiscible) berdasarkan perbedaan massa jenis. Contoh: memisahkan air dan kloroform."
            },
            {
                q: "11. Tuliskan 4 aturan berpakaian keselamatan (dress code) wajib saat berada di dalam laboratorium kimia!",
                ans: "1. Memakai jas lab lengan panjang dikancing rapi.\n2. Menggunakan safety goggles.\n3. Menggunakan sepatu tertutup.\n4. Mengikat rambut panjang ke belakang."
            },
            {
                q: "12. Mengapa pelepasan gas CO2 dari reaksi kimia berlebih menjadi ancaman lingkungan global?",
                ans: "Karena gas CO2 adalah Gas Rumah Kaca (GRK) yang menangkap panas di atmosfer dan memicu pemanasan global serta perubahan iklim."
            },
            {
                q: "13. Sebutkan alat laboratorium porselen yang digunakan untuk menghaluskan kristal kimia dan jelaskan cara kerjanya!",
                ans: "Mortal dan Alu (Mortar and Pestle). Cara kerjanya dengan menggerus kristal padat di dalam wadah mortal menggunakan alu hingga halus."
            },
            {
                q: "14. Jelaskan bahaya dari piktogram GHS 'Nyala Api di Atas Lingkaran' (Flame over Circle) dan berikan contoh zatnya!",
                ans: "Menandakan zat pengoksidasi (oxidizing) yang melepaskan oksigen sehingga dapat memicu/memperhebat kebakaran. Contoh: Kalium Permanganat (KMnO4)."
            },
            {
                q: "15. Tuliskan contoh penerapan prinsip Kimia Hijau ke-7 yaitu penggunaan Bahan Baku Terbarukan!",
                ans: "Pembuatan bioetanol dan biodiesel dari limbah biomassa pertanian atau minyak nabati untuk menggantikan bahan bakar fosil."
            }
        ];

        // RENDER SOAL PG
        function renderPG() {
            const container = document.getElementById('pg-container');
            container.innerHTML = '';

            pgData.forEach((data, idx) => {
                let html = `
                    <div class="question-card" id="q-card-${idx}">
                        <p class="q-text">${data.q}</p>
                        <ul class="options-list">
                `;
                data.options.forEach((opt, optIdx) => {
                    html += `
                        <li>
                            <label>
                                <input type="radio" name="pg-${idx}" value="${optIdx}">
                                ${opt}
                            </label>
                        </li>
                    `;
                });
                html += `
                        </ul>
                        <div class="answer-box" id="ans-box-${idx}">
                            ${data.desc}
                        </div>
                    </div>
                `;
                container.innerHTML += html;
            });
        }

        // RENDER SOAL ESAI
        function renderEssai() {
            const container = document.getElementById('essai-container');
            container.innerHTML = '';

            essaiData.forEach((data, idx) => {
                let html = `
                    <div class="question-card">
                        <p class="q-text">${data.q}</p>
                        <textarea class="essay-input" placeholder="Ketik jawaban Anda di sini untuk latihan..."></textarea>
                        <button type="button" class="btn-toggle" onclick="toggleAnswer(${idx})">Lihat Kunci Jawaban & Pembahasan</button>
                        <div class="answer-box" id="essai-ans-${idx}">
                            <strong>Kunci Jawaban:</strong><br>${data.ans.replace(/\n/g, '<br>')}
                        </div>
                    </div>
                `;
                container.innerHTML += html;
            });
        }

        // SWITCH TAB
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

            if (tabName === 'pg') {
                document.querySelectorAll('.tab-btn')[0].classList.add('active');
                document.getElementById('tab-pg').classList.add('active');
            } else {
                document.querySelectorAll('.tab-btn')[1].classList.add('active');
                document.getElementById('tab-essai').classList.add('active');
            }
        }

        // PERIKSA NILAI PG
        function gradePG() {
            let score = 0;
            let total = pgData.length;

            pgData.forEach((data, idx) => {
                const selected = document.querySelector(`input[name="pg-${idx}"]:checked`);
                const ansBox = document.getElementById(`ans-box-${idx}`);
                ansBox.style.display = 'block';

                if (selected && parseInt(selected.value) === data.ans) {
                    score++;
                    document.getElementById(`q-card-${idx}`).style.borderColor = '#22c55e';
                } else {
                    document.getElementById(`q-card-${idx}`).style.borderColor = '#ef4444';
                }
            });

            const finalScore = (score / total) * 100;
            const scoreDisplay = document.getElementById('score-display');
            scoreDisplay.style.display = 'block';
            scoreDisplay.innerHTML = `Hasil Latihan Pilihan Ganda Anda: ${score} dari ${total} Soal Benar (Nilai: ${finalScore.toFixed(1)})`;
            scoreDisplay.scrollIntoView({ behavior: 'smooth' });
        }

        // TOGGLE KUNCI ESAI
        function toggleAnswer(idx) {
            const ansBox = document.getElementById(`essai-ans-${idx}`);
            if (ansBox.style.display === 'block') {
                ansBox.style.display = 'none';
            } else {
                ansBox.style.display = 'block';
            }
        }

        // INITIALIZE ON LOAD
        window.onload = function() {
            renderPG();
            renderEssai();
        };
    </script>
</body>
</html>
